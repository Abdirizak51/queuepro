# QueuePro – Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=queuepro
DB_USER=root
DB_PASS=

APP_URL=http://localhost/queuepro

# Email (for password reset in production)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=noreply@queuepro.so
MAIL_PASS=
MAIL_FROM_NAME=QueuePro
